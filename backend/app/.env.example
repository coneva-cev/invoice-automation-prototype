AUTH0_DOMAIN=coneva-rnd.eu.auth0.com
AUTH0_AUDIENCE=https://invoice-automation/api

# Single source of truth for the API permission required to use the app.
REQUIRED_PERMISSION=admin

# M2M application credentials for token exchange (backend confidential client)
AUTH0_CLIENT_ID=<your-m2m-client-id>
AUTH0_CLIENT_SECRET=<your-m2m-client-secret>

# Monitoring API (Coneva Connect)
MONITORING_API_AUDIENCE=https://monitoring.conevaconnect.com/api
MONITORING_API_BASE_URL=https://portal.dev-conevacloud.com
# Static authorization-scope for the multi-tenant bulk-upload endpoint.
# For single-tenant monitoring API calls, pass the tenant's topologyId dynamically.
MONITORING_API_BULK_UPLOAD_SCOPE=9
