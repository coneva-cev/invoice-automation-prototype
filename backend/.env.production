# Production defaults (non-secret). Real secrets are injected at deploy time
# (env vars or a secret manager), NOT committed here.
#
# APP_ENV=production => email backend "sendgrid" with sandbox OFF:
# emails are really delivered.
APP_ENV=production

EMAIL_FROM="coneva <noreply@coneva.com>"

# Provided at deploy time (do not commit the real value):
# SENDGRID_API_KEY=SG.xxxxx
#
# Real delivery is fail-closed: even with APP_ENV=production the app forces
# SendGrid sandbox unless this second opt-in is explicitly set. Enable it only
# where you truly intend to email real recipients.
# EMAIL_ALLOW_REAL_SEND=true
