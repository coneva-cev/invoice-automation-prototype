# Backend environment template. Copy to `.env` and fill in real secrets.
# `.env` is gitignored; this file documents every variable.
#
# APP_ENV selects per-environment defaults for the email transport:
#
#   APP_ENV       email backend   sandbox   delivers?
#   ------------  --------------  --------  -------------------------------
#   local         smtp (Mailpit)  -         no  (captured locally)
#   staging       sendgrid        on        no  (validated, not delivered)
#   production    sendgrid        off       yes
#
# Explicit EMAIL_BACKEND / SENDGRID_SANDBOX below still override the APP_ENV
# default if you set them.
APP_ENV=local

# --- Auth0 (required) ------------------------------------------------------
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://invoice-automation/api
AUTH0_CLIENT_ID=xxxxx
AUTH0_CLIENT_SECRET=xxxxx

# --- Monitoring / Portal API (required) ------------------------------------
# Base URL includes the topology API path; the bulk-upload endpoint is then
# {MONITORING_API_BASE_URL}/v2/documents-bulk-upload.
MONITORING_API_AUDIENCE=https://monitoring.conevaconnect.com/api
MONITORING_API_BASE_URL=https://portal.dev-conevacloud.com/api/topology
MONITORING_API_BULK_UPLOAD_SCOPE=9

# --- Email --------------------------------------------------------------- #
# From address used for all outgoing mail.
EMAIL_FROM="coneva <noreply@coneva.com>"

# Reply-To address set on SendGrid emails (where customer replies go). Defaults
# to service@conevasupport.com; set empty to omit a Reply-To header.
# EMAIL_REPLY_TO=service@conevasupport.com

# Every outgoing email is blind-copied (BCC) to this billing archive address.
# Comma-separate for multiple; set empty to disable. Defaults to
# billing@coneva.com when unset.
# EMAIL_BCC=billing@coneva.com

# Optional explicit override of the APP_ENV-derived backend:
#   console | smtp | sendgrid
# EMAIL_BACKEND=smtp

# SMTP backend (local / Mailpit). Defaults shown.
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=false

# SendGrid backend (staging / production). Secret — keep out of git.
# SENDGRID_API_KEY=SG.xxxxx
# Optional explicit override of the APP_ENV-derived sandbox flag:
# SENDGRID_SANDBOX=true

# --- Email mode + send destinations (delivery safety) --------------------- #
# EMAIL_MODE is the single authority for whether a send can reach a real
# customer. It controls which destinations the UI may offer:
#
#   test  -> mailpit | sendgrid_sandbox | sendgrid_coneva
#            EVERY recipient (To/Cc/Bcc) is replaced with a domain-allowed
#            address chosen in the UI. No email can reach a real customer.
#   live  -> sendgrid_sandbox | sendgrid_live
#            sendgrid_live delivers to the real recipients from the mapping.
#
# If unset, EMAIL_MODE is derived from APP_ENV (production => live, else test),
# so a fresh environment is safe (test) by default. Set explicitly to be sure.
# EMAIL_MODE=test

# Default replacement address pre-filled in the UI (editable per send). It must
# belong to an allowed domain (below). Only relevant in test mode.
# EMAIL_TEST_RECIPIENTS=you@coneva.com

# Domains a test-mode replacement address must belong to (comma-separated).
# Defaults to coneva.com; an empty value falls back to the default (the
# guardrail can never be silently disabled).
# EMAIL_TEST_ALLOWED_DOMAINS=coneva.com

# Console backend: optionally dump .eml files instead of sending.
# EMAIL_OUTBOX_DIR=/tmp/invoice_outbox
