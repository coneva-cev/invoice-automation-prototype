# Staging defaults (non-secret). Real secrets are injected at deploy time
# (env vars or a secret manager), NOT committed here.
#
# APP_ENV=staging => email backend "sendgrid" with sandbox ON:
# requests are validated against SendGrid but nothing is delivered.
APP_ENV=staging

EMAIL_FROM="coneva <noreply@coneva.com>"

# Provided at deploy time (do not commit the real value):
# SENDGRID_API_KEY=SG.xxxxx
# SENDGRID_SANDBOX defaults to true for staging; override only if needed.
