# Vendored read-only clone of the upstream Coneva library (not part of this app)
storybook/

# Node
node_modules/
dist/
*.local

# Python
.venv/
__pycache__/
*.pyc

# Sample data — real customer PDFs / billing spreadsheets, never commit
backend/samples/
test-files/

# Env / secrets — never commit the GitHub Packages token
.env
.env.*
*.token
# ...but DO commit non-secret, per-environment templates (placeholders only).
!.env.example
!.env.staging
!.env.production

# Allow committed example env files (real .env / .env.local stay ignored)
!.env.example
!**/.env.example

# OS
.DS_Store
